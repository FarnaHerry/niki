// platform/windows/app.rc.in — version metadata for the executable.
//
// The designer draws its own window chrome and carries no icon resource yet, so
// this is intentionally just the version block: it is what makes the built
// hui.exe identify itself in Explorer and in crash reports.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @HUI_VERSION_COMMA@
PRODUCTVERSION @HUI_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "hui — HuxerUI Designer\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "hui\0"
      VALUE "OriginalFilename", "hui.exe\0"
      VALUE "ProductName", "hui\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
